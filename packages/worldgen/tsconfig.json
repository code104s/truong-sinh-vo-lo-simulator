{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
